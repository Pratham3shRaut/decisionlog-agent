# Slack API Tokens
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# User token (xoxp-) with the 'search:read' scope, needed for MCP-based
# cross-channel search (search.messages is not callable with a bot token).
SLACK_USER_TOKEN=

# Google Gemini API Key
GEMINI_API_KEY=

# Database Configuration
DATABASE_URL=

# Logging Configuration
LOGGING_ENABLED=false
