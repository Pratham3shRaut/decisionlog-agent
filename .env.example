# Slack API Tokens
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# User token (xoxp-) with the 'search:read' scope, needed for MCP-based
# cross-channel search (search.messages is not callable with a bot token).
SLACK_USER_TOKEN=

# LLM provider: "gemini" (default) or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Optional overrides (defaults shown):
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Database Configuration
DATABASE_URL=

# Logging Configuration
LOGGING_ENABLED=false
