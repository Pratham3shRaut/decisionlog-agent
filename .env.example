# Bot token — starts with xoxb-. Found at: Slack App Dashboard > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Signing secret — used to verify requests come from Slack. Found at: Slack App Dashboard > Basic Information > App Credentials > Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret

# App-level token — starts with xapp-, required for Socket Mode. Found at: Slack App Dashboard > Basic Information > App-Level Tokens (create one with the "connections:write" scope)
SLACK_APP_TOKEN=xapp-your-app-token

# Optional — set to "true" to enable verbose Bolt logging during local dev
DEBUG=false
